# Rendered at container start by the nginx image's entrypoint: the ${OC3_*}
# placeholders come from the environment, nginx's own $variables are left as is.

# Keep the scheme the TLS gateway in front of this container saw, so that oc3
# builds its redirects with https.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen ${OC3_LISTEN_PORT};
    listen [::]:${OC3_LISTEN_PORT};
    server_name _;

    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # Liveness probe for the orchestrator; says nothing about oc3.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The oc3 API, path kept as is.
    location /api/ {
        proxy_pass ${OC3_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        # Compliance imports and form definitions go beyond nginx's 1m default;
        # exports of large lists take a while to compute.
        client_max_body_size ${OC3_MAX_BODY_SIZE};
        proxy_read_timeout 300s;
    }

    # The websocket of the oc3 messenger, which announces the changes.
    location /realtime {
        proxy_pass ${OC3_REALTIME_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Bundled files carry a content hash in their name: cache them for good, and
    # never answer a missing one with index.html.
    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Any other path is a route of the application: serve index.html, never
    # cached, so that a new release is picked up at the next load.
    location / {
        try_files $uri /index.html;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
}
